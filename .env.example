# ─── MSME Viability Assessment — Environment Variables ───────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# ─── API Security ─────────────────────────────────────────────────────────────
# Secret key for the FastAPI endpoints (X-API-Key header)
MSME_API_KEY=msme-dev-key-2024

# ─── LLM Providers (at least one required for Chat Coach) ────────────────────

# Option 1: Groq — FREE tier, no billing required
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Note: If neither key is provided, the Chat Coach uses offline rule-based mode.

# ─── Streamlit Frontend ───────────────────────────────────────────────────────
# URL of the running FastAPI backend
# Local development: http://localhost:8000
# Production (Render): https://msme-viability-assessment.onrender.com
API_URL=http://localhost:8000
